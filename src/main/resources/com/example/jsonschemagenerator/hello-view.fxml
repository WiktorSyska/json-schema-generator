<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.jsonschemagenerator.HelloController"
      prefWidth="700" prefHeight="600">
    <padding>
        <Insets bottom="16.0" left="16.0" right="16.0" top="16.0"/>
    </padding>

    <!-- Top bar: file info + buttons -->
    <HBox spacing="10.0" alignment="CENTER_LEFT">
        <Button text="Wczytaj JSON..." onAction="#onLoadFile" mnemonicParsing="false"/>
        <Label fx:id="fileNameLabel" text="Nie wczytano pliku" style="-fx-text-fill: #666;"/>
        <HBox HBox.hgrow="ALWAYS"/>
        <Button text="Generuj schemat" onAction="#onGenerateSchema" mnemonicParsing="false"/>
        <Button text="Waliduj plik..." onAction="#onValidate" mnemonicParsing="false"/>
        <Button text="Zapisz schemat..." onAction="#onSaveSchema" mnemonicParsing="false"/>
    </HBox>

    <!-- Status label -->
    <Label fx:id="statusLabel" text="" style="-fx-font-size: 12;" wrapText="true"/>

    <!-- Schema output -->
    <Label text="Wygenerowany JSON Schema:" style="-fx-font-weight: bold;"/>
    <TextArea fx:id="schemaOutput" editable="false" wrapText="true"
              promptText="Tutaj pojawi się wygenerowany schemat..."
              VBox.vgrow="ALWAYS"
              style="-fx-font-family: 'Consolas', 'Monaco', monospace; -fx-font-size: 13;"/>

    <!-- Validation output -->
    <Label text="Wynik walidacji:" style="-fx-font-weight: bold;"/>
    <TextArea fx:id="validationOutput" editable="false" wrapText="true"
              promptText="Tutaj pojawi się wynik walidacji..."
              prefRowCount="6"
              style="-fx-font-family: 'Consolas', 'Monaco', monospace; -fx-font-size: 12;"/>
</VBox>
