<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TreeView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="700.0" prefWidth="1100.0" spacing="12.0"
      xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.jsonschemagenerator.views.controllers.HelloController">
    <padding>
        <Insets bottom="16.0" left="16.0" right="16.0" top="16.0"/>
    </padding>

    <!-- Top bar: file info + buttons -->
    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Button mnemonicParsing="false" onAction="#onLoadFile" text="Wczytaj JSON..."/>
        <Label fx:id="fileNameLabel" style="-fx-text-fill: #666;" text="Nie wczytano pliku"/>
        <HBox HBox.hgrow="ALWAYS"/>
        <Button fx:id="generateButton" mnemonicParsing="false" onAction="#onGenerateSchema" text="Generuj schemat"/>
        <Button fx:id="generateMultipleButton" mnemonicParsing="false" onAction="#onGenerateSchemaFromMultiple" text="Generuj dla wielu"/>
        <Button fx:id="validateButton" mnemonicParsing="false" onAction="#onValidate" text="Waliduj plik..."/>
        <Button fx:id="saveSchemaButton" mnemonicParsing="false" onAction="#onSaveSchema" text="Zapisz schemat..."/>
        <Button fx:id="editSchemaButton" mnemonicParsing="false" onAction="#onEditSchemaClick" text="Edytuj schemat"/>
        <Button mnemonicParsing="false" onAction="#onOpenSchemaManager" text="Schematy..."/>
    </HBox>

    <!-- Status label -->
    <Label fx:id="statusLabel" style="-fx-font-size: 12;" text="" wrapText="true"/>

    <!-- Split view: trees on the left, raw schema on the right -->
    <SplitPane dividerPositions="0.45" VBox.vgrow="ALWAYS">

        <!-- LEFT: TabPane with JSON tree and Schema tree -->
        <VBox spacing="6.0">
            <padding><Insets bottom="4.0" left="4.0" right="4.0" top="4.0"/></padding>
            <Label style="-fx-font-weight: bold;" text="Podgląd drzewa (przeciągnij tu plik JSON):"/>
            <TabPane VBox.vgrow="ALWAYS" tabClosingPolicy="UNAVAILABLE">
                <Tab text="JSON">
                    <TreeView fx:id="jsonTreeView"/>
                </Tab>
                <Tab text="Schemat">
                    <TreeView fx:id="schemaTreeView"/>
                </Tab>
            </TabPane>
        </VBox>

        <!-- RIGHT: raw schema text -->
        <VBox spacing="6.0">
            <padding><Insets bottom="4.0" left="4.0" right="4.0" top="4.0"/></padding>
            <Label style="-fx-font-weight: bold;" text="Wygenerowany JSON Schema:"/>
            <TextArea fx:id="schemaOutput" editable="false"
                      promptText="Tutaj pojawi się wygenerowany schemat..."
                      style="-fx-font-family: 'Consolas', 'Monaco', monospace; -fx-font-size: 13;"
                      wrapText="true" VBox.vgrow="ALWAYS"/>
        </VBox>
    </SplitPane>

    <!-- Validation output -->
    <Label style="-fx-font-weight: bold;" text="Wynik walidacji:"/>
    <TextArea fx:id="validationOutput" editable="false" prefRowCount="5"
              promptText="Tutaj pojawi się wynik walidacji..."
              style="-fx-font-family: 'Consolas', 'Monaco', monospace; -fx-font-size: 12;"
              wrapText="true"/>
</VBox>
